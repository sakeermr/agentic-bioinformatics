# ============================================================
# Agentic Bioinformatics Research Assistant - Environment Config
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- LLM API Keys ----
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here        # Optional fallback

# ---- Primary LLM Provider ----
# Options: openai | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini                          # or gpt-4o for higher quality

# ---- Embedding Model ----
EMBEDDING_MODEL=text-embedding-3-small

# ---- NCBI / PubMed ----
NCBI_API_KEY=your_ncbi_api_key_here            # Free at: https://www.ncbi.nlm.nih.gov/account/
NCBI_EMAIL=your_email@example.com              # Required by NCBI

# ---- ChromaDB ----
CHROMA_DB_PATH=./chroma_db

# ---- Report Output ----
REPORTS_DIR=./reports

# ---- FastAPI ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Streamlit ----
STREAMLIT_PORT=8501

# ---- Logging ----
LOG_LEVEL=INFO
